[server]
host = 0.0.0.0
port = 7125
klippy_uds_address = /home/cp/printer_1_data/comms/klippy.sock

[authorization]
trusted_clients = 
	192.168.0.0/24
	10.254.254.0/24
	127.0.0.0/8
	::1/128
	FE80::/10
cors_domains = 
	*.lan
	*.local
	*://localhost
	*://localhost:*
	*://my.mainsail.xyz
	*://app.fluidd.xyz

[octoprint_compat]

[file_manager]
enable_object_processing = false

[history]

[update_manager]
channel = dev
refresh_interval = 168

[update_manager mainsail-config]
type = git_repo
primary_branch = master
path = ~/mainsail-config
origin = https://github.com/mainsail-crew/mainsail-config.git
managed_services = moonraker

[update_manager mainsail]
type = web
channel = stable
repo = mainsail-crew/mainsail
path = ~/mainsail

